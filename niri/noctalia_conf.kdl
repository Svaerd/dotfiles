spawn-at-startup "noctalia"

window-rule {
  // Rounded corners for a modern look.
  geometry-corner-radius 20

  // Clips window contents to the rounded corner boundaries.
  clip-to-geometry true
}

// Floating Noctalia settings window.
window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}

debug {
  // Allows notification actions and window activation from Noctalia.
  honor-xdg-activation-with-invalid-serial
}

// Set the overview wallpaper on the backdrop.
layer-rule {
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}

// For laptop lids
switch-events {
    lid-close { spawn "noctalia" "msg" "session" "lock-and-suspend"; }
}

//===BLUR===//
// /* Apps: blur them all without xray for a better look */
window-rule {
  opacity 0.90
  background-effect {
    blur true
    xray false
  }
}

blur {
  passes 3        // more passes = stronger blur (default: 3)
  offset 3.5      // sample distance per pass (default: 3.0)
  noise 0.03      // grain overlay (default: 0.02)
  saturation 1.0  // color saturation boost (default: 1.5)
}

/* Noctalia: blur everywhere without xray for a better look */
layer-rule {
  match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
  background-effect {
    xray false
  }
}

/* Enable blur on noctalia's window switcher and disable xray. */
layer-rule {
  match namespace="noctalia-window-switcher"
  background-effect {
    blur true
    xray false
  }
}
//========//

binds {
    // Core Noctalia binds
    Mod+Space { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+S { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Comma { spawn-sh "noctalia msg settings-toggle"; }
    // Alt+Tab { spawn-sh "noctalia msg window-switcher"; }
    Mod+Alt+L { spawn-sh "noctalia msg session lock-and-suspend"; }
    Mod+SemiColon { spawn-sh "noctalia msg panel-toggle session"; }

    // Launcher related binds
    Mod+V { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Mod+Period { spawn-sh "noctalia msg panel-toggle launcher /emo"; }

    // Notification
    Mod+N { spawn-sh "noctalia msg panel-toggle control-center notifications"; }
    Mod+Shift+N { spawn-sh "noctalia msg notification-dnd-toggle"; }

    // Toggle bar & widgets
    Ctrl+Super+R { spawn-sh "killall ags agsv1 gjs ydotool qs quickshell; noctalia msg panel-toggle launcher"; }

    // Audio & Brightness
    XF86AudioRaiseVolume { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute { spawn-sh "noctalia msg volume-mute"; }
    XF86MonBrightnessUp { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown { spawn-sh "noctalia msg brightness-down"; }
}

layout {

    focus-ring {
        active-color   "#cba6f7"
        inactive-color "#1e1e2e"
        urgent-color   "#f38ba8"
    }

    border {
        active-color   "#cba6f7"
        inactive-color "#1e1e2e"
        urgent-color   "#f38ba8"
    }

    shadow {
        color "#11111b70"
    }

    tab-indicator {
        active-color   "#cba6f7"
        inactive-color "#6b02e9"
        urgent-color   "#f38ba8"
    }

    insert-hint {
        color "#cba6f780"
    }
}

recent-windows {
    highlight {
        active-color "#cba6f7"
        urgent-color "#f38ba8"
        padding 7
        corner-radius 10
    }
    previews {
      max-scale 0.2
    }
    binds {
      Mod+Tab       { next-window       scope="workspace"; }
      Mod+Shift+Tab { previous-window   scope="workspace"; }
      Alt+Tab       { next-window       scope="all"; }
      Alt+Shift+Tab { previous-window   scope="all"; }
    }
}
