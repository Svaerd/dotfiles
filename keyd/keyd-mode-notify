#!/usr/bin/env bash
# keyd-mode-notify: notify on keyd mode-layer toggles (vim_mode, macro_mode).

declare -A LABELS=(
    [vim_mode]="Vim Mode"
    [macro_mode]="Macro Mode"
)

watch_layers=(vim_mode macro_mode)

keyd listen | while IFS= read -r line; do
    [[ "$line" =~ ^([+-])([A-Za-z0-9_]+)$ ]] || continue
    op=${BASH_REMATCH[1]}
    layer=${BASH_REMATCH[2]}

    for watched in "${watch_layers[@]}"; do
        [[ "$layer" == "$watched" ]] || continue
        state="Entered"
        [[ "$op" == "-" ]] && state="Exited"
        notify-send -t 2000 -u low -a keyd "${LABELS[$layer]:-$layer}: $state"
        break
    done
done